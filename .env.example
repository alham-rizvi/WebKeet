# Supabase project config. VITE_ values are public and become part of browser assets.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Direct Postgres URL used only when running Drizzle migrations.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Optional server-only configuration.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# WEBGOAT_PROVISIONER_URL=https://spawner.example.com
# WEBGOAT_PROVISIONER_TOKEN=SET_THE_SAME_STRONG_TOKEN_ON_THE_PROVISIONER
# WEBKEET_CRON_SECRET=OPTIONAL_STRONG_CRON_TOKEN
